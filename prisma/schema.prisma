// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  username String @id @unique
  password String
  rol      String
}

model Frente {
  nombre               String     @id @unique
  excelUrlGasolinaBlob String?
  excelUrlAcarreosBlob String?
  ticketsGasolina      Gasolina[] @relation("FrenteGasolina")
  ticketsAcarreos      Acarreos[] @relation("FrenteAcarreos")
}

model Acarreos {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  folio        String
  frenteNombre String
  empresa      String
  material     String
  cubicacion   Float
  fecha        DateTime
  placas       String
  noEmpleado   String
  idCamion     String
  operador     String
  checador     String
  hora         DateTime
  proyecto     String
  banco        String
  frente       Frente   @relation("FrenteAcarreos", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, idCamion])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, material])
}

model Gasolina {
  uuid           String   @id @default(uuid())
  createdAt      DateTime @default(now())
  folio          String
  frenteNombre   String
  saldoCompra    Float
  formatoPago    String
  autorizacion   String
  litros         Float
  fecha          DateTime
  placas         String
  hora           DateTime
  total          Float
  bomba          Int
  precioUnitario Float
  frente         Frente   @relation("FrenteGasolina", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, folio])
}
