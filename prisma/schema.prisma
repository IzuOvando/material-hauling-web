// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  username String @id @unique
  password String
  rol      String
}

model Frente {
  nombre                    String          @id @unique
  excelUrlGasolinaBlob      String?
  excelUrlAcarreosBlob      String?
  excelUrlConcretoBlob      String?
  excelUrlVoucherCamionBlob String?
  excelUrlAsfaltoBlob       String?
  ticketsGasolina           Gasolina[]      @relation("FrenteGasolina")
  ticketsAcarreos           Acarreos[]      @relation("FrenteAcarreos")
  VoucherCamion             VoucherCamion[] @relation("FrenteVoucherCamion")
  ticketsConcreto           Concreto[]      @relation("FrenteConcreto")
  ticketsAsfalto            Asfalto[]       @relation("FrenteAsfalto")
}

model VoucherCamion {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  voucherDate  DateTime
  voucherTime  DateTime
  tiro         String
  origen       String
  material     String
  placas       String
  operador     String
  turno        Int
  noEconomico  String
  empresa      String
  cubicacion   Float
  checkerName  String
  noEmpleado   String
  checkerNo    String?
  frenteNombre String
  idCamion     String
  frente       Frente   @relation("FrenteVoucherCamion", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index(createdAt)
  @@index([frenteNombre, voucherDate])
  @@index([frenteNombre, voucherTime])
  @@index([frenteNombre, idCamion])
  @@index([frenteNombre, origen])
  @@index([frenteNombre, tiro])
  @@index([frenteNombre, material])
}

model Acarreos {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  folio        Int
  frenteNombre String
  empresa      String
  material     String
  cubicacion   Float
  fecha        DateTime
  placas       String
  noEmpleado   String
  idCamion     String
  operador     String
  checador     String
  hora         DateTime
  proyecto     String
  banco        String
  frente       Frente   @relation("FrenteAcarreos", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, idCamion])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, material])
}

model Gasolina {
  uuid           String   @id @default(uuid())
  createdAt      DateTime @default(now())
  folio          String
  frenteNombre   String
  saldoCompra    Float
  formatoPago    String
  autorizacion   String
  litros         Float
  fecha          DateTime
  placas         String
  hora           DateTime
  total          Float
  bomba          Int
  precioUnitario Float
  frente         Frente   @relation("FrenteGasolina", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, placas])
  @@index([frenteNombre, bomba])
}

model Concreto {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  frenteNombre String
  cubicacion   Float
  cliente      String
  empresa      String
  planta       String
  operador     String
  fecha        DateTime
  fc           String
  destino      String
  rev          Int
  tempConcreto Float
  tempAmbiente Float
  noEconomico  String
  marca        String
  elemento     String
  horaSalida   DateTime
  uso          String   @default("")
  placas       String
  frente       Frente   @relation("FrenteConcreto", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, elemento])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, noEconomico])
  @@index([frenteNombre, destino])
}

model Asfalto {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  frenteNombre String
  cubicacion   Float
  material     String
  empresa      String
  planta       String
  operador     String
  fecha        DateTime
  destino      String
  tempAsfalto  Float
  noEconomico  String
  marca        String
  placas       String
  frente       Frente   @relation("FrenteAsfalto", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, material])
  @@index([frenteNombre, noEconomico])
  @@index([frenteNombre, destino])
}
