// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum VoucherStatus {
  IN_TRANSIT
  ARRIVED
}

model User {
  username   String  @id @unique
  password   String
  rol        String
  nombre     String?
  apPaterno  String?
  apMaterno  String?
  noEmpleado String?
  frentes    UserFrente[]
}

model UserFrente {
  userId       String
  frenteNombre String

  user   User   @relation(fields: [userId], references: [username], onDelete: Cascade)
  frente Frente @relation(fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@id([userId, frenteNombre])
}


model Frente {
  nombre                    String          @id @unique
  frenteKey                 String?         @unique
  logoUrl                   String?
  logoHash                  String?
  logoUpdatedAt             DateTime?
  excelUrlGasolinaBlob      String?
  excelUrlAcarreosBlob      String?
  excelUrlConcretoBlob      String?
  excelUrlVoucherCamionBlob String?
  excelUrlAsfaltoBlob       String?
  ticketsGasolina           Gasolina[]      @relation("FrenteGasolina")
  ticketsAcarreos           Acarreos[]      @relation("FrenteAcarreos")
  VoucherCamion             VoucherCamion[] @relation("FrenteVoucherCamion")
  ticketsConcreto           Concreto[]      @relation("FrenteConcreto")
  ticketsAsfalto            Asfalto[]       @relation("FrenteAsfalto")
  users                     UserFrente[]
  materials                 MaterialFrente[]
}

model Material {
  id        String   @id @default(uuid())
  nombre    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  frentes MaterialFrente[]
}

model MaterialFrente {
  materialId   String
  frenteNombre String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  frente   Frente   @relation(fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@id([materialId, frenteNombre])
  @@index([frenteNombre])
}

model VoucherCamion {
  folio        String   @id
  createdAt    DateTime @default(now())
  voucherDatetime  DateTime
  destino      String
  origen       String
  material     String
  placas       String
  status       VoucherStatus @default(IN_TRANSIT)
  odometerArrival Float?
  odometer     Float      @default(0)
  arrivalTime  DateTime?
  operador     String
  turno        Int
  localidad    String   @default("N/A")
  noEconomico  String
  empresa      String
  cubicacion   Float
  checkerName  String
  noEmpleado   String
  checkerNo                    String?
  createdByUsername            String?
  arrivalCheckerName           String?
  arrivalCheckerEmployeeNumber String?
  frenteNombre String
  idCamion     String
  frente       Frente   @relation("FrenteVoucherCamion", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  latitude          Float?
  longitude         Float?
  locationAccuracy  Float?
  locationTimestamp DateTime?
  locationStatus    String?
  locationSource    String?

  arrivalLatitude          Float?
  arrivalLongitude         Float?
  arrivalLocationAccuracy  Float?
  arrivalLocationTimestamp DateTime?
  arrivalLocationStatus    String?
  arrivalLocationSource    String?

  @@index(createdAt)
  @@index([frenteNombre, voucherDatetime])
  @@index([frenteNombre, idCamion])
  @@index([frenteNombre, origen])
  @@index([frenteNombre, destino])
  @@index([frenteNombre, material])
}

model Acarreos {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  folio        Int
  frenteNombre String
  empresa      String
  material     String
  cubicacion   Float
  fecha        DateTime
  placas       String
  noEmpleado   String
  idCamion     String
  operador     String
  checador     String
  hora         DateTime
  proyecto     String
  banco        String
  frente       Frente   @relation("FrenteAcarreos", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, idCamion])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, material])
}

model Gasolina {
  uuid           String   @id @default(uuid())
  createdAt      DateTime @default(now())
  folio          String
  frenteNombre   String
  saldoCompra    Float
  formatoPago    String
  autorizacion   String
  litros         Float
  fecha          DateTime
  placas         String
  hora           DateTime
  total          Float
  bomba          Int
  precioUnitario Float
  frente         Frente   @relation("FrenteGasolina", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, placas])
  @@index([frenteNombre, bomba])
}

model Concreto {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  frenteNombre String
  cubicacion   Float
  cliente      String
  empresa      String
  planta       String
  operador     String
  fecha        DateTime
  fc           String
  destino      String
  rev          Int
  tempConcreto Float
  tempAmbiente Float
  noEconomico  String
  marca        String
  elemento     String
  horaSalida   DateTime
  uso          String   @default("")
  placas       String
  frente       Frente   @relation("FrenteConcreto", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, elemento])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, noEconomico])
  @@index([frenteNombre, destino])
}

model Asfalto {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  frenteNombre String
  cubicacion   Float
  material     String
  empresa      String
  planta       String
  operador     String
  fecha        DateTime
  destino      String
  tempAsfalto  Float
  noEconomico  String
  marca        String
  horaSalida   DateTime @default(now())
  placas       String
  frente       Frente   @relation("FrenteAsfalto", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre, fecha])
  @@index([frenteNombre, empresa])
  @@index([frenteNombre, material])
  @@index([frenteNombre, noEconomico])
  @@index([frenteNombre, destino])
}
