// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  username String @id
  password String
}

model Ticket {
  uuid    String @default(uuid()) @unique
  empresa  String
  material String
  cubicacion String
  fecha String
  placa String
  idCamion String
  operador String
  checador String
  hora String
  banco String
  createdAt DateTime @default(now())
}

model QueryView {
  id       Int      @id @default(autoincrement())
  filterName     String
  filters  String     
  username   String
  createdAt DateTime @default(now())
}