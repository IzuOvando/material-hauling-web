// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  username String @id @unique
  password String
  rol      String
}

model Frente {
  nombre          String     @id @unique
  ticketsGasolina Gasolina[] @relation("FrenteGasolina")
  ticketsAcarreos Acarreos[] @relation("FrenteAcarreos")
}

model Acarreos {
  uuid         String   @id @default(uuid())
  createdAt    DateTime @default(now())
  folio        String
  frenteNombre String
  empresa      String
  material     String
  cubicacion   String
  fecha        String
  placas       String
  noEmpleado   String
  idCamion     String
  operador     String
  checador     String
  hora         String
  proyecto     String
  banco        String
  frente       Frente   @relation("FrenteAcarreos", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre])
}

model Gasolina {
  uuid           String   @id @default(uuid())
  createdAt      DateTime @default(now())
  folio          String
  frenteNombre   String
  saldoCompra    String
  formatoPago    String
  autorizacion   String
  litros         String
  fecha          String
  placas         String
  hora           String
  total          String
  bomba          String
  precioUnitario String
  frente         Frente   @relation("FrenteGasolina", fields: [frenteNombre], references: [nombre], onDelete: Cascade)

  @@index([frenteNombre])
}
