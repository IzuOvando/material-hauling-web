// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  username String @id @unique
  password String
}

model Frente {
  nombre  String   @id @unique
  tickets Ticket[]
}

model Ticket {
  uuid         String   @unique @default(uuid())
  empresa      String
  material     String
  cubicacion   String
  fecha        String
  placas       String
  noEmpleado   String
  idCamion     String
  operador     String
  checador     String
  hora         String
  proyecto     String
  banco        String
  createdAt    DateTime @default(now())
  frenteNombre String
  frente       Frente   @relation(fields: [frenteNombre], references: [nombre])
}

model QueryView {
  id         Int      @id @default(autoincrement())
  filterName String
  filters    String
  username   String
  createdAt  DateTime @default(now())
}
